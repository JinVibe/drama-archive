# Copy to .env for local Docker Compose. Never commit .env.

# PostgreSQL (System of Record + pgvector)
POSTGRES_USER=dramamemory
POSTGRES_PASSWORD=dramamemory
POSTGRES_DB=dramamemory
POSTGRES_PORT=5432

# Airflow metadata DB lives in the same PostgreSQL instance, separate database
AIRFLOW_DB=airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_PORT=8080

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage for raw snapshots, local only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
RAW_BUCKET=dramamemory-raw
