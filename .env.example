# Copy to .env for local Docker Compose. Never commit .env.

# PostgreSQL (System of Record + pgvector)
POSTGRES_USER=dramamemory
POSTGRES_PASSWORD=dramamemory
POSTGRES_DB=dramamemory
POSTGRES_PORT=5432

# Airflow metadata DB lives in the same PostgreSQL instance, separate database
AIRFLOW_DB=airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_PORT=8080

# Redis
REDIS_PORT=6379

# S3-compatible object storage for raw snapshots (RustFS, local only)
S3_ACCESS_KEY=dramamemory
S3_SECRET_KEY=dramamemory
S3_PORT=9000
S3_CONSOLE_PORT=9001
RAW_BUCKET=dramamemory-raw

# domain-api session cookie HMAC key (>= 32 bytes). Rotating it logs every browser out.
SESSION_COOKIE_SECRET=local-dev-only-session-secret-change-me-0000

# Neo4j (derived graph read model, local only)
NEO4J_PASSWORD=dramamemory-neo4j

# Admin review queue (/admin, X-Admin-Token). Interim until OAuth + RBAC. Empty = disabled.
ADMIN_TOKEN=local-dev-admin-token

# ai-api: optional cross-encoder rerank for /v1/search?rerank=true (none | bge). ~1.1 GB model download.
AI_API_RERANKER=none
